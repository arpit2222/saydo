# ==============================================
# SayDo Environment Configuration (.env.example)
# ==============================================

# API & Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Nebius Token Factory (OpenAI-compatible endpoint)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=your_nebius_api_key_here

# Nemotron Model Routing
NEMOTRON_FAST_MODEL=nvidia/nemotron-mini-4b-instruct
NEMOTRON_AGENT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_REASON_MODEL=nvidia/nemotron-4-340b-instruct

# Tavily API (Search, Extract, Docs Discovery)
TAVILY_API_KEY=tvly-your_tavily_key_here

# Supabase (Postgres & Service Role Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Demo Defaults
DEFAULT_APP_PUBLIC_KEY=pk_demo_dehix
